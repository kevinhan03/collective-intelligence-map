# Copy to .env.local. Never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Configure Google OAuth and the Supabase callback URLs before first sign-in.
# Places REST keys: server only
GOOGLE_PLACES_API_KEY=
PROVIDER_SIGNING_SECRET=
# Separate browser renderer keys: restrict domains and APIs in provider console.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Off until operator reviews policies and enables budgets in /admin/usage
GOOGLE_PLACES_ENABLED=false
# Extra password gate for /admin/usage, on top of the admin role check.
ADMIN_USAGE_PASSWORD=

# Optional: direct PostgreSQL connection for schema migrations; never exposed to the app.
SUPABASE_DB_URL=

# Korea search: enable the Kakao budget in /admin/usage as well.
KAKAO_REST_API_KEY=
# Backward-compatible name accepted by the server; use one, not both.
# KAKAO_LOCAL_API_KEY=
KAKAO_PLACES_ENABLED=false
NEXT_PUBLIC_KAKAO_MAPS_KEY=
# Default deny: enable only after documenting permission for these stored fields.
KAKAO_REF_STORAGE_ALLOWED=false
KAKAO_PLACE_STORAGE_ALLOWED=false
# International rendering: licensed MapLibre style URL, independent of search.
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=
# ETL-only database connection. Never put into NEXT_PUBLIC_*.
OVERTURE_DATABASE_URL=
